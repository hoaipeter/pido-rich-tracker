# =============================================================================
# Pido Rich Tracker — environment variables
# =============================================================================
# 1. Copy this file:        Copy-Item .env.example .env
# 2. Fill in real values BELOW. Do NOT commit the resulting .env file.
# 3. Full reference:        docs/SETUP.md#environment-variables
#
# Validation runs at startup in src/backend/config/env.ts. The app exits
# fast with a clear message if a required variable is missing or has a
# placeholder-shaped value in production.
# =============================================================================

# --- Datastore --------------------------------------------------------------
# Atlas SRV URI. Replace USER, PASS, and the cluster host. Use a dedicated
# database user with the minimum permissions required (readWrite on the app DB).
MONGODB_URI=
MONGODB_DB=

# --- Auth.js ----------------------------------------------------------------
# REQUIRED. Generate with:  openssl rand -base64 32
# Must be at least 32 chars. Production rejects values that look like
# "placeholder", "change-me", "example", "replace".
AUTH_SECRET=

# Public origin (no trailing slash). On Vercel this is auto-injected from
# VERCEL_URL — leave blank in Vercel projects.
AUTH_URL=http://localhost:3000

# Set to "true" ONLY when self-hosting behind a trusted reverse proxy.
# In production this is rejected unless VERCEL is also set.
AUTH_TRUST_HOST=

# Comma-separated allowlist for /register. Invite acceptance bypasses this.
AUTH_ALLOWED_EMAILS=you@example.com

# --- OAuth (optional) -------------------------------------------------------
# Both must be set together for the Google provider to register.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (optional) -------------------------------------------------------
# When unset, invite emails are no-op'd and the raw URL is returned to the
# inviter. See docs/SETUP.md section 4 for free Gmail-SMTP setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Public origin used to build invite URLs. Defaults to AUTH_URL when blank.
APP_URL=

# --- Rate-limit backend (production) ----------------------------------------
# In production the in-memory rate-limit is rejected because it does not
# survive serverless cold starts. Set RATE_LIMIT_BACKEND=upstash and provide
# Upstash REST credentials from https://console.upstash.com.
RATE_LIMIT_BACKEND=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Logging ----------------------------------------------------------------
# One of: debug | info | warn | error. Defaults to "info" in production.
LOG_LEVEL=info
