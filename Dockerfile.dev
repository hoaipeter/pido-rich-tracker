# syntax=docker/dockerfile:1.7
#
# Development image: keeps the full toolchain and runs `next dev` with HMR.
# The host source tree is bind-mounted in via docker compose; this image
# only exists to provide a consistent Node + Yarn environment.

# Pin to a digest (node:20.18-alpine@sha256:...) in shared dev environments.
ARG NODE_VERSION=20.18-alpine

FROM node:${NODE_VERSION}
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=development \
    YARN_CACHE_FOLDER=/root/.yarn

RUN apk add --no-cache libc6-compat tini

COPY package.json yarn.lock* ./
RUN --mount=type=cache,target=/root/.yarn \
    yarn install --frozen-lockfile --ignore-scripts --network-timeout 600000

EXPOSE 3000
STOPSIGNAL SIGTERM
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["yarn", "dev"]
